<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.ch08.b4.WelcomeController" alignment="CENTER" spacing="16"
      stylesheets="@login.css" styleClass="login-pane">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label fx:id="lblWelcome" styleClass="title" wrapText="true"/>
    <Button text="Đăng xuất" onAction="#handleLogout" styleClass="primary-btn"/>
</VBox>
